# Fourni automatiquement par Railway si vous ajoutez le plugin PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/filifing_db

# Générez une clé aléatoire forte pour la production
# ex: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changez-cette-cle-secrete-en-production-absolument

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
UPLOAD_DIR=uploads

# URL publique du backend Railway (ex: https://mon-backend.up.railway.app)
BASE_URL=http://localhost:8000

# URL(s) du frontend autorisées pour le CORS (séparées par virgule)
# En prod: l'URL Railway de votre frontend
CORS_ORIGINS=http://localhost:3000
